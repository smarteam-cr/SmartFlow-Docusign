# Server
PORT=3002
NODE_ENV=development

# HubSpot — Private App access token (Bearer token)
# Get it from: HubSpot Portal → Settings → Integrations → Private Apps → your app → Auth tab
HUBSPOT_ACCESS_TOKEN=

# DocuSign — JWT Grant credentials
# See spec §14 for step-by-step setup of these values.
DOCUSIGN_CLIENT_ID=
DOCUSIGN_IMPERSONATED_USER_ID=
# DOCUSIGN_PRIVATE_KEY: paste the full multi-line RSA private key on a single line
# with literal \n between lines (dotenv parses these). Example:
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n...\n-----END RSA PRIVATE KEY-----"
# Plan 2's JWT auth code will replace \n with real newlines before signing.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net

# Configuración de firmantes por template DocuSign.
# Ya NO vive aquí: la edita el cliente en el objeto personalizado "Parametros DC"
# de HubSpot. Esta variable es solo su objectTypeId, que es específico de cada
# portal (Configuración → Objetos → Objetos personalizados → Parametros DC).
#
# Propiedades que lee el backend de cada fila:
#   pais                      → tab countryINVE ("Guatemala IV"/"QST" → "Guatemala")
#   template                  → lista desplegable; el value es el templateId de DocuSign
#   legal_representative_code → hs_object_id del contacto Proveedor  (routingOrder 4)
#   cm_id_hubspot_code        → hs_object_id del contacto CM         (routingOrder 2)
#   usuario_legal             → hs_object_id del contacto Legal      (routingOrder 3)
#
# El Supervisor (routingOrder 1) NO sale de aquí: es la propiedad `supervisor`
# del Deal, de tipo "Usuario de HubSpot" (guarda un ownerId).
HUBSPOT_PARAMETROS_DC_OBJECT_TYPE=2-

# DocuSign Connect — HMAC secret for webhook verification
DOCUSIGN_CONNECT_HMAC_SECRET=

# HubSpot portal ID (used for PDF URLs and webhook correlation)
HUBSPOT_PORTAL_ID=
