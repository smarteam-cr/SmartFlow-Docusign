# Server
PORT=3000
NODE_ENV=development

# HubSpot — Private App access token (Bearer token)
# Get it from: HubSpot Portal → Settings → Integrations → Private Apps → your app → Auth tab
HUBSPOT_ACCESS_TOKEN=

# DocuSign — JWT Grant credentials
# See spec §14 for step-by-step setup of these values.
DOCUSIGN_CLIENT_ID=
DOCUSIGN_IMPERSONATED_USER_ID=
# DOCUSIGN_PRIVATE_KEY: paste the full multi-line RSA private key on a single line
# with literal \n between lines (dotenv parses these). Example:
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n...\n-----END RSA PRIVATE KEY-----"
# Plan 2's JWT auth code will replace \n with real newlines before signing.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net
